# Copy this file to .env and fill in your real values.
# Never commit the actual .env file.

# --- Database: Supabase Postgres connection string ---
# Find this under Project Settings > Database > Connection string (URI)
# in your Supabase dashboard.
DATABASE_URL=postgresql:
# --- OpenAI (Phase 3+: embeddings + RAG generation) ---
OPENAI_API_KEY=sk-your-key-here


OPENROUTER_API_KEY=sk-

# --- Google Gemini (Phase 3+: NLP generation) ---
# Name = Kilimo, Project name = projects/
GEMINI_API_KEY=key
GEMINI_MODEL=gemini-3.8-flash

# --- WhatsApp Cloud API (Phase 6) ---
# Filled in once you create a Meta developer app + test phone number.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0

# --- App ---
ENVIRONMENT=development
ADMIN_API_TOKEN=your-admin-api-token-here


# --- Huey (background task queue) ---
# Path to the local SQLite file Huey uses as its broker/result store.
HUEY_DB_PATH=huey.db
